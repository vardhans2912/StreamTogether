# ---------------------------------------------------------------------------
# StreamTogether frontend configuration
# Copy this file to `.env` and adjust as needed.
# ---------------------------------------------------------------------------

# Mock mode
# ---------
# "true"  -> The app runs entirely standalone. All domain APIs (auth, rooms,
#            chat, media, users) resolve against an in-memory + localStorage
#            backed fake backend. Real-time sync across browser tabs is done
#            with BroadcastChannel. No backend server is required.
# "false" -> The app talks to the real API gateway over HTTP via axios.
#            Backend devs should set this once controllers exist.
VITE_USE_MOCK=true

# API gateway base URL
# --------------------
# Only used when VITE_USE_MOCK=false. The Spring Cloud gateway is expected to
# route /{service-id}/** to the corresponding registered service.
VITE_API_BASE_URL=http://localhost:8888

# Realtime (STOMP over WebSocket) endpoint
# ---------------------------------------
# Optional. Playback sync, chat and presence are pushed over a single WebSocket
# to stream-service (Eureka id MEDIA-SERVICE), reached through the gateway like
# every other call. Defaults to VITE_API_BASE_URL with ws:// and the
# /media-service/ws path, so you normally do not need to set this. Override it
# to bypass the gateway (e.g. ws://localhost:8084/ws) or for wss:// in
# production. If the socket cannot connect the Room page degrades to polling.
# VITE_WS_URL=ws://localhost:8888/media-service/ws
